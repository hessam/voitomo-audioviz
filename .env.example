# ==============================================================================
# Voitomo Audioviz - Environment Configuration Template
# ==============================================================================

# OpenRouter LLM API (Required for Art Direction & Scene Synthesis)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Telegram Bots (Required if running the Telegram Interface)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUDIOVIZ_BOT_TOKEN=your_audioviz_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Speech Recognition & Feature Extraction
WHISPER_MODEL=medium

# Cloud GPU (primary: Modal). Set GPU_PROVIDER=vast and restart the bot to switch to Vast.ai.
GPU_PROVIDER=modal
MODAL_GPU_URL=https://your-workspace--audioviz-gpu-gpu-services.modal.run
MODAL_PROXY_TOKEN_ID=your_modal_proxy_token_id_here
MODAL_PROXY_TOKEN_SECRET=your_modal_proxy_token_secret_here
# CPU control endpoint (printed by `modal deploy` next to the GPU URL). Status, budget
# checks and release use it, so they never start the GPU.
MODAL_CONTROL_URL=https://your-workspace--audioviz-gpu-control.modal.run
# GPU type (deploy time), idle seconds before scale-down, cold-start wait.
# 60s is a starting point, not a measurement: set it near the median cold start printed by
# `python3 -m bot.services.modal_gpu` (keeping a container warm longer than a cold start
# takes costs more than restarting it).
MODAL_GPU_TYPE=L4
MODAL_SCALEDOWN_SECONDS=60
MODAL_COLD_START_TIMEOUT_SECONDS=600
# Cost guardrails. A job is refused before it starts when it cannot fit under the daily cap,
# and a running job is stopped at 95% of it. Dollars per UTC day.
MODAL_DAILY_CAP_USD=2.00
# Quiet seconds after the last job before the bot releases the GPU (also unmeasured).
MODAL_RELEASE_QUIET_SECONDS=20
# Optional: reconcile the estimate with Modal's own bill (needs `pip install modal` and a
# Modal login on the bot host). The higher of the two numbers is used.
MODAL_BILLING_RECONCILE=0
# Container size (deploy time; the cost estimate uses the same values).
MODAL_CPU=4
MODAL_MEMORY_MB=8192
# Optional overrides: total price per container-second, and where the bot keeps its lease ledger.
# MODAL_GPU_RATE_PER_SECOND=0.00029
# GPU_LEDGER_PATH=~/.audioviz/gpu_lease_ledger.jsonl

# Cloud GPU (secondary: Vast.ai)
VAST_API_KEY=your_vast_api_key_here
GPU_IDLE_TIMEOUT_SECONDS=900

# Renderer Configuration
RENDERER_URL=http://127.0.0.1:4001
VAULT_STORAGE_PATH=/tmp/audioviz-vault

# Visualizer styles offered in the bot menu (comma separated, in menu order).
# Available: sphere, orrery, cymatic, bodies. Add a new style here only after it has passed review.
AUDIOVIZ_ENABLED_STYLES=sphere

# How the finished video is sent: document (original quality, default), video (Telegram inline
# player, re-encoded by Telegram), or both.
AUDIOVIZ_DELIVERY=document

# Optional Cloudflare R2 delivery: full-quality file, any size, sent as a link. When all four
# R2_* values are set, the bot uploads there first and falls back to Telegram if R2 fails.
# Add a bucket lifecycle rule "delete after 1 day"; the link expires after R2_LINK_HOURS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_LINK_HOURS=24
