# ==============================================================================
# Voitomo Audioviz - Environment Configuration Template
# ==============================================================================

# OpenRouter LLM API (Required for Art Direction & Scene Synthesis)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Telegram Bots (Required if running the Telegram Interface)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUDIOVIZ_BOT_TOKEN=your_audioviz_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Speech Recognition & Feature Extraction
WHISPER_MODEL=medium

# Cloud GPU Bursting (Optional - Vast.ai)
VAST_API_KEY=your_vast_api_key_here
GPU_IDLE_TIMEOUT_SECONDS=900

# Renderer Configuration
RENDERER_URL=http://127.0.0.1:4001
VAULT_STORAGE_PATH=/tmp/audioviz-vault
